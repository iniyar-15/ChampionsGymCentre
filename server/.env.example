# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# ── App ───────────────────────────────────────────────────────────────────────
# Azure App Service sets PORT automatically — leave as 8080 or omit
PORT=8080
# Your Azure domain (or custom domain). Comma-separated for multiple.
CLIENT_URL=https://your-app.azurewebsites.net

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
# Generate at: myaccount.google.com > Security > App Passwords (not your login password)
SMTP_PASS=your_16_char_app_password

# ── Notifications ─────────────────────────────────────────────────────────────
MANAGER_EMAIL=manager@example.com
GYM_NAME=Champions Gymnastics Center

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxx
RAZORPAY_KEY_SECRET=your_secret

# ── Scheduler ─────────────────────────────────────────────────────────────────
# IMPORTANT: Set to "true" on exactly ONE instance only to avoid duplicate emails
CRON_ENABLED=true
